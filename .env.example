# AfyaCare Tanzania — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's already in .gitignore).

# ─── Supabase ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Error Tracking (optional) ─────────────────────────────────
# Sign up at: https://sentry.io
VITE_SENTRY_DSN=

# ─── Analytics (optional) ──────────────────────────────────────
# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=

# ─── Feature Flags ─────────────────────────────────────────────
# Set to 'true' to force legacy WorldClassApp mode (dev/testing only)
VITE_LEGACY_MODE=false

# ─── MongoDB (optional, future use) ────────────────────────────
# Not read by the app. backend/ussd-server.js does not connect to MongoDB.
# If a future deploy does, set the real value only in the host environment.
# Placeholder only — never commit a username, password, or host.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
