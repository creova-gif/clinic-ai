# AfyaCare Tanzania — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's already in .gitignore).

# ─── Supabase ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Error Tracking (optional) ─────────────────────────────────
# Sign up at: https://sentry.io
VITE_SENTRY_DSN=

# ─── Analytics (optional) ──────────────────────────────────────
# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=

# ─── Feature Flags ─────────────────────────────────────────────
# Set to 'true' to force legacy WorldClassApp mode (dev/testing only)
VITE_LEGACY_MODE=false

# Clinical triage / AI assessment (CRE-13 product hold).
# Off by default. Set to the exact string true ONLY for a supervised pilot or demo.
# When omitted or anything other than true, triage must not present risk levels
# or possible-condition suggestions. The UI shows an EN/SW product-hold notice.
# When true, every triage result still shows an unvalidated decision-support banner.
# urgent and emergency stay separate levels; neither is stored as high.
VITE_CLINICAL_TRIAGE_ENABLED=false

# Server-side USSD triage (backend/ussd-server.js). Same hold, separate process.
# Off unless exactly true. Not read by the Vite app.
CLINICAL_TRIAGE_ENABLED=false
